shell-integration = zsh

# font-family = "MesloLGS Nerd Font Mono"
font-family = "FiraCode Nerd Font Mono"
theme = dark:Rose Pine,light:Rose Pine Dawn

# background-image = /Users/darryl.effendi/.config/dotfiles/ghostty/backgrounds/bg-matsuya-blur.png
# background-image-fit = cover
# background-opacity = 1
# background = 0a0a0a

background-opacity = 0.85
background-blur = macos-glass-regular

background = 0a0a0d
foreground = e0def4
background-blur-radius = 25
selection-background = 393552
selection-foreground = e0def4

window-decoration = true
macos-titlebar-style = hidden

cursor-style = block
cursor-style-blink = false

window-padding-x = 20
window-padding-y = 5
window-padding-balance = true

window-save-state = never

keybind = cmd+t=unbind
keybind = cmd+n=unbind
keybind = cmd+shift+t=new_window

#quick terminal
quick-terminal-position = center
quick-terminal-screen =  mouse
quick-terminal-autohide = false
quick-terminal-animation-duration = 0

# keybinds
keybind = global:cmd+\=toggle_quick_terminal

# Shaders
custom-shader = shaders/cursor_tail.glsl
custom-shader = shaders/ripple_rectangle_cursor.glsl
